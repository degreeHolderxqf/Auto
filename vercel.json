{
  "version": 2,
  "builds": [
    {
      "src": "src/server.cjs",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/server.cjs"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "crons": [
    {
      "path": "/api/email/batch/worker",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/server.cjs": {
      "maxDuration": 300
    }
  }
}
