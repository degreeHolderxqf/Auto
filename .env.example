# ==========================================
# Shopify Partner -> HR Lead Generation System
# Configuration & Environment Variables
# ==========================================

# --- SaaS Account Service ---
# Use a durable PostgreSQL database. The application never runs migrations at startup.
DATABASE_URL=
SAAS_DB_POOL_MAX=10
# Public frontend origin used in email verification and password reset links.
APP_PUBLIC_URL=http://localhost:3001
# Generate a long random value and configure it only on the backend for one-time admin setup.
ADMIN_BOOTSTRAP_TOKEN=
# Protects the scheduled email batch worker; configure the same value in Vercel.
CRON_SECRET=

# --- SMTP Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=himanshusoni7899@gmail.com
SMTP_PASS=
EMAIL_FROM="Himanshu Soni <himanshusoni7899@gmail.com>"

# --- Paths ---
RESUME_PATH=26_Himanshu-Soni-Shopify.pdf
DATABASE_PATH=data/leads.sqlite
EXCLUSIONS_PATH=data/excluded_companies.csv
OUTPUT_DIR=output
LOGS_DIR=logs

# --- Lead Discovery & Targeting ---
SHOPIFY_PARTNER_DIRECTORY_URL=https://www.shopify.com/in/partners/directory/locations/india?minPrice=&maxPrice=&sort=DEFAULT
TARGET_LEADS=100
MIN_APP_RELEVANCE_SCORE=70
TARGET_COUNTRY=India

# --- Employee Size Verification (Optional) ---
# Set to a positive number (e.g. 30) to require that many employees.
# Keep at 0 to leave employee size optional (all sizes accepted).
MIN_EMPLOYEE_COUNT=0

# --- Safety & Sending Controls ---
DRY_RUN=true
SEND_LIMIT=50
EMAIL_DELAY_MS=5000
BATCH_SIZE=50
BATCH_DELAY_MS=60000
MAX_RETRIES=2
RETRY_DELAY_MS=5000

# --- Search Provider Options ---
# Merchant store discovery uses free public search results from Brave, Bing, and DuckDuckGo.
# This avoids the Brave 429 rate limit and keeps bulk lead discovery working without an API key.
# SEARCH_PROVIDER=brave
# SEARCH_API_KEY is not used for merchant store discovery.

# --- Freelance/job domain resolution ---
# Set to serpapi and provide SEARCH_API_KEY to resolve explicitly named companies.
# For eligible existing Google Custom Search API accounts, also set GOOGLE_CSE_ID.
# GOOGLE_CSE_ID=
# FREELANCE_MAX_CONCURRENCY=2  # capped at 4

# --- Optional Shopify store revenue estimation ---
REVENUE_ESTIMATION_MODE=free
# Free public-data collection is the default; no third-party credentials are needed.
# A locally imported Tranco rank is a popularity signal only, never monthly visits.
# Set REVENUE_ESTIMATION_MODE=paid explicitly before allowing billable provider calls.
# DataForSEO estimates organic and paid search traffic; that metric is not total site visits.
# Provider requests are billable when credentials are configured.
# TRAFFIC_PROVIDER=dataforseo
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=
# Conversion-rate assumptions are global scenarios, not category-specific benchmarks.
# REVENUE_LOW_CONVERSION_RATE=0.005
# REVENUE_BASE_CONVERSION_RATE=0.015
# REVENUE_HIGH_CONVERSION_RATE=0.03
# REVENUE_ESTIMATE_REFRESH_DAYS=30
# REVENUE_FAILURE_RETRY_HOURS=24

# --- Optional Shopify Store Performance Audits ---
# Free-quota Google PageSpeed Insights API; an API key is required.
# Gemini drafts are generated from verified PageSpeed observations and are reviewed before sending.
# No audit email is sent until it is explicitly approved and sent in the frontend.
# Set these only on the backend; never expose keys through NEXT_PUBLIC_* variables.
# PAGESPEED_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Evolution Go WhatsApp Outreach ---
EVOLUTION_API_URL=https://evolution-api-latest-h0yy.onrender.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=job-search
WHATSAPP_ENABLED=true
WHATSAPP_DRY_RUN=true
WHATSAPP_DELAY_MS=15000
